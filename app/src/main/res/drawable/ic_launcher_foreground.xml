<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Original glyph (below) fills ~80% of the canvas edge-to-edge, which reads as oversized
         and loses padding once masked into a launcher's icon shape. Scaled down 40% around the
         canvas center so it sits inside the adaptive-icon safe zone with breathing room, matching
         the padding other apps' launcher icons have. -->
    <group
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:pivotX="100"
        android:pivotY="100">

        <!-- top clock circle -->
        <path
            android:pathData="M19,70 A49,49 0 1,0 117,70 A49,49 0 1,0 19,70"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round" />

        <!-- top clock hands: ten and two -->
        <path
            android:pathData="M68,70 L43,56"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5.5"
            android:strokeLineCap="round" />
        <path
            android:pathData="M68,70 L93,56"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5.5"
            android:strokeLineCap="round" />

        <!-- bottom clock circle -->
        <path
            android:pathData="M83,130 A49,49 0 1,0 181,130 A49,49 0 1,0 83,130"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round" />

        <!-- bottom clock hands: four o'clock -->
        <path
            android:pathData="M132,130 L132,100"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5.5"
            android:strokeLineCap="round" />
        <path
            android:pathData="M132,130 L154,151"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5.5"
            android:strokeLineCap="round" />

    </group>

</vector>
